;;; theme-generate.el --- Port the Modus and Ef themes to Alacritty and SketchyBar  -*- lexical-binding: t -*-

;; Run with `theme generate'.  Every color is resolved through
;; `modus-themes-get-color-value' from the packages installed in
;; ~/.emacs.d/elpa (ef-themes 2.x is built on modus-themes 5), so the
;; terminal and the bar match Emacs exactly.  Re-run after upgrading either
;; package.  Writes alacritty/themes/<name>.toml and sketchybar/themes/<name>.sh.

(require 'seq)

(dolist (pkg '("modus-themes" "ef-themes"))
  (let ((dir (car (last (file-expand-wildcards
                         (locate-user-emacs-file (format "elpa/%s-[0-9]*" pkg)))))))
    (unless dir (error "%s is not installed in ~/.emacs.d/elpa" pkg))
    (add-to-list 'load-path dir)
    (add-to-list 'custom-theme-load-path dir)))
(require 'modus-themes)
(require 'ef-themes)

(defconst tg-config-dir
  (file-name-as-directory (or (getenv "XDG_CONFIG_HOME") (expand-file-name "~/.config"))))

(defconst tg-alacritty-spec
  '(("colors.primary" (background bg-main) (foreground fg-main) (dim_foreground fg-dim))
    ("colors.cursor" (cursor cursor) (text bg-main))
    ("colors.vi_mode_cursor" (cursor cursor) (text bg-main))
    ;; Ef themes leave fg-region unspecified: keep each cell's own color then
    ("colors.selection" (background bg-region) (text fg-region "CellForeground"))
    ("colors.search.matches" (background bg-search-lazy) (foreground fg-search-lazy))
    ("colors.search.focused_match" (background bg-search-current) (foreground fg-search-current))
    ("colors.footer_bar" (background bg-mode-line-active) (foreground fg-mode-line-active))
    ("colors.normal"
     (black fg-term-black) (red fg-term-red) (green fg-term-green) (yellow fg-term-yellow)
     (blue fg-term-blue) (magenta fg-term-magenta) (cyan fg-term-cyan) (white fg-term-white))
    ("colors.bright"
     (black fg-term-black-bright) (red fg-term-red-bright) (green fg-term-green-bright)
     (yellow fg-term-yellow-bright) (blue fg-term-blue-bright) (magenta fg-term-magenta-bright)
     (cyan fg-term-cyan-bright) (white fg-term-white-bright)))
  "Alacritty tables as (TABLE (KEY PALETTE-NAME [FALLBACK]) ...).")

(defconst tg-surface-min-contrast 1.15
  "How far the pill of a workspace with windows must stand out from the bar.")

(defun tg-color (theme name)
  "Hex value of palette entry NAME in THEME, or nil if it is unspecified."
  (let ((value (modus-themes-get-color-value name nil theme)))
    (and (stringp value) (string-prefix-p "#" value) value)))

(defun tg-surface (theme bar)
  "Subtlest neutral of THEME that stands out from the BAR background.
Ef themes space their neutrals differently, so no single palette name
works for all of them; bg-inactive is nearly invisible in most."
  (let ((bar-hex (tg-color theme bar)))
    (or (seq-find (lambda (name)
                    (let ((hex (tg-color theme name)))
                      (and hex (>= (modus-themes-contrast hex bar-hex) tg-surface-min-contrast))))
                  '(bg-inactive bg-dim bg-alt bg-active))
        'bg-active)))

(defun tg-sketchybar-spec (theme kind)
  "SketchyBar variables of THEME as (VAR PALETTE-NAME [ALPHA]); nil is a blank line."
  (let ((bar (if (eq kind 'light) 'bg-dim 'bg-main)))
    `((RED red) (GREEN green) (YELLOW yellow) (BLUE blue) (MAGENTA magenta) (CYAN cyan)
      nil
      ;; Light: a shade off the windows; dark: the window background itself
      (BAR_BG ,bar)
      (FG fg-main) (FG_SOFT fg-dim) (FG_DIM fg-dim) (FG_FAINT border)
      (FG_FAINTER ,(if (eq kind 'light) 'border 'bg-active))
      (SURFACE ,(tg-surface theme bar))
      nil
      (SELECTION_BG bg-completion) (SELECTION_FG fg-main)
      (ATTENTION_BG bg-prominent-warning) (ATTENTION_FG fg-prominent-warning)
      (NOTICE_BG bg-yellow-subtle) (NOTICE_FG fg-main)
      nil
      (POPUP_BG bg-dim "e6") (POPUP_BORDER blue))))

(defun tg-header (theme kind)
  "First line of every generated file; `theme' reads KIND and the doc from it."
  (let ((doc (plist-get (get theme 'theme-properties) :modus-documentation)))
    (format "# %s (%s): %s\n# Generated by theme-generate.el from the Emacs palette; don't edit by hand.\n"
            theme kind (car (split-string doc "\n")))))

(defun tg-hex (theme name)
  (or (tg-color theme name) (error "%s: %s is unspecified" theme name)))

(defun tg-alacritty (theme kind)
  (concat
   (tg-header theme kind)
   (mapconcat
    (pcase-lambda (`(,table . ,keys))
      (concat
       (format "\n[%s]\n" table)
       (mapconcat (pcase-lambda (`(,key ,name ,fallback))
                    (if-let* ((hex (tg-color theme name)))
                        (format "%s = \"%s\" # %s\n" key hex name)
                      (format "%s = \"%s\"\n" key (or fallback (tg-hex theme name)))))
                  keys "")))
    tg-alacritty-spec "")))

(defun tg-sketchybar (theme kind)
  (concat
   "#!/usr/bin/env bash\n"
   (tg-header theme kind)
   "\n"
   (mapconcat (lambda (entry)
                (pcase-let ((`(,var ,name ,alpha) entry))
                  (if (null entry) ""
                    (format "%s=0x%s%s # %s" var (or alpha "ff")
                            (substring (tg-hex theme name) 1) name))))
              (tg-sketchybar-spec theme kind)
              "\n")))

(defun tg-write (file content)
  (with-temp-file file (insert content (if (string-suffix-p "\n" content) "" "\n"))))

(let ((themes (append modus-themes-items ef-themes-items)))
  (dolist (theme themes)
    (load-theme theme t t)
    (let ((kind (plist-get (get theme 'theme-properties) :background-mode)))
      (tg-write (format "%salacritty/themes/%s.toml" tg-config-dir theme) (tg-alacritty theme kind))
      (tg-write (format "%ssketchybar/themes/%s.sh" tg-config-dir theme) (tg-sketchybar theme kind))))
  (princ (format "theme-generate: wrote %d themes\n" (length themes))))

;;; theme-generate.el ends here
